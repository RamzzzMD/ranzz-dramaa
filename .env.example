# Port server HTTP
PORT=3000

# Host binding (gunakan 0.0.0.0 untuk deploy di VPS / Railway / Render)
HOST=0.0.0.0

# Bahasa default katalog & subtitle dari scraper (id-ID atau en-US)
DEFAULT_LANGUAGE=id-ID

# TTL Cache In-Memory (dalam detik)
CACHE_TTL_CATALOG=360
CACHE_TTL_SEARCH=300
CACHE_TTL_DETAIL=600
CACHE_TTL_CATEGORIES=900
CACHE_TTL_STREAM=90

# Rate Limiter API (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_API=120
RATE_LIMIT_MAX_PROXY=600
